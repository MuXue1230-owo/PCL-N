<StackPanel xmlns="https://pcln.dev/pxml/2026" Key="TaskCard" Orientation="Vertical" Spacing="6"
            Padding="16,14,16,14">
  <!--
    One task card, instantiated per task center entry. State copy, icons, progress, and step
    rows are filled at frame time by the task center controller; cancel and dismiss carry the
    entry identity through the source entity, resolved by walking to the card root.
  -->
  <StackPanel Key="TaskCardHeader" Orientation="Horizontal">
    <Image Key="TaskCardIcon" Source="lucide/loader-circle" Width="18" Height="18"
           Margin="0,3,8,0" />
    <Text Key="TaskCardTitle" Content="任务" Height="22" Weight="1" />
    <Button Key="TaskCardAction" Icon="lucide/x" Label="取消任务"
            Command="ui.tasks.card.cancel" Width="30" Height="30" />
  </StackPanel>
  <StackPanel Key="TaskCardStatus" Orientation="Horizontal">
    <Text Key="TaskCardStage" Content="正在准备" Height="16" Weight="1" />
    <Text Key="TaskCardPercent" Content="0%" Height="16" Margin="12,0,0,0" />
  </StackPanel>
  <ContentHost Key="TaskCardTrack" Height="6">
    <Progress Key="TaskCardFill" Height="6" Label="任务进度条" />
  </ContentHost>
  <StackPanel Key="TaskCardMeta" Orientation="Horizontal">
    <Text Key="TaskCardFiles" Content="" Height="16" Weight="1" />
    <Text Key="TaskCardSpeed" Content="" Height="16" />
  </StackPanel>
  <Text Key="TaskCardError" Content="" Height="16" IsVisible="false" />
  <ContentHost Key="TaskCardStepsHost">
    <StackPanel Key="TaskCardSteps" Orientation="Vertical" Spacing="2" IsVisible="false" />
  </ContentHost>
</StackPanel>
